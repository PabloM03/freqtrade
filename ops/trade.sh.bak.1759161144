#!/usr/bin/env bash
set -euo pipefail
set -x  # verboso al journal

# Log explícito al journal
logger -t trade "[trade] usando /home/ubuntu/freqtrade/ops/config.withparams.json"

# Lanzar freqtrade SIEMPRE con ese config, verboso
exec freqtrade -v trade \
  -c /home/ubuntu/freqtrade/ops/config.withparams.json \
  --loglevel info
