# ops/.env — Tokens para el pipeline de sentimiento
# Copia este archivo como ops/.env y rellena tus tokens

# CryptoPanic — noticias crypto con sentimiento por coin
# Regístrate GRATIS en: https://cryptopanic.com/developers/api/
# (2 minutos, sin tarjeta de crédito)
CRYPTOPANIC_TOKEN=pon_tu_token_aqui

# Whale Alert — transacciones grandes de ballenas BTC/ETH
# Plan GRATIS en: https://whale-alert.io/pricing
WHALE_ALERT_KEY=pon_tu_key_aqui

# Anthropic API — para ops/analyze_news.py (análisis temático con Claude AI)
# Obtén tu key en: https://console.anthropic.com/
# Coste aprox: claude-haiku ~$0.001/artículo → 50 noticias/día = ~$0.05/día
ANTHROPIC_API_KEY=pon_tu_key_aqui
