{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDC",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "15m",
  "dry_run": true,
  "db_url": "sqlite:///trades.sqlite",
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "user_data_dir": "./user_data",
  "strategy": "MyStrategy",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_ratio": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDC",
      "APE/USDC",
      "GIGGLE/USDC",
      "FET/USDC",
      "HBAR/USDC",
      "PENGU/USDC",
      "ACT/USDC",
      "TURBO/USDC",
      "ENA/USDC",
      "EIGEN/USDC",
      "JTO/USDC",
      "LINK/USDC",
      "NEAR/USDC",
      "OP/USDC",
      "RENDER/USDC",
      "TON/USDC"
    ],
    "pair_blacklist": [
      "INJ/.*",
      "ARB/.*",
      "GUN/.*",
      "ZRO/.*",
      "BLUR/.*",
      "ENJ/.*",
      "TAO/.*",
      "AAVE/.*",
      "WLD/.*",
      "TIA/.*",
      "DOT/.*",
      "XRP/.*",
      "AVAX/.*",
      "LTC/.*",
      "BNB/.*",
      "WBTC/.*",
      "WETH/.*",
      "DOGE/.*",
      "ADA/.*",
      "FLOKI/.*",
      "SOL/.*",
      "PEPE/.*",
      "SHIB/.*",
      "EUR/.*",
      "EURC/.*",
      "EURI/.*",
      "EURS/.*",
      "PAXG/.*",
      "XAUT/.*",
      "STETH/.*",
      "WSTETH/.*",
      "CBETH/.*",
      "RETH/.*",
      ".*(UP|DOWN|BEAR|BULL).*",
      ".*3L.*",
      ".*3S.*",
      ".*5L.*",
      ".*5S.*",
      ".*10L.*",
      ".*10S.*",
      ".*LONG.*",
      ".*SHORT.*",
      "^(USDC|USDT|BUSD|TUSD|FDUSD|DAI|FRAX|USDP|GUSD|SUSD|UST|USD1|USDD|USDE|USDX|USDY)/.*",
      "^U/.*",
      "ROBO/.*",
      ".*/(?!USDC$).*",
      "^USDC/.*",
      "LUNC/.*",
      "LUNA/.*",
      ".*(SWAP|FARM|VAULT|DEFI|EARN)/.*"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": []
  },
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": true,
  "internals": {
    "process_throttle_secs": 5
  }
}
